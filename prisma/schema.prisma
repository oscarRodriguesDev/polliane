// Schema do banco Supabase (Postgres) — acessado via Prisma.
// Dois modelos:
//   Admin  — usuário mestre do painel (login e troca de senha).
//   Media  — fotos/vídeos enviados pelo mestre e exibidos pelo bot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id          Int       @id @default(autoincrement())
  tag         MediaTag // normal | medium | hot_medium | hot
  type        MediaType // image | video
  storagePath String    @unique // caminho no bucket (ex.: polli/hot/foto1.jpg)
  fileUrl     String // URL pública do arquivo
  mimeType    String
  sizeBytes   Int
  description String? // descrição da foto, usada pelo bot pra escolher/enviar sabendo o que é
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tag])
  @@index([type])
}

enum MediaTag {
  normal
  medium
  hot_medium
  hot
}

enum MediaType {
  image
  video
}

// Histórico de conversa persistido por canal/conversa (web, Telegram, etc.).
// A conversa NÃO some quando o servidor reinicia — fica no Postgres.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  chatKey   String // "web" pro site, "<telegram_id>" pro Telegram, etc.
  role      String   // "user" | "assistant"
  content   String
  imageUrl  String?
  bubbles   Json? // balões da mensagem do assistant (lista de strings)
  createdAt DateTime @default(now())

  @@index([chatKey, id])
}

// Memória de longo prazo por conversa: o que a Pollianne aprendeu sobre a
// pessoa (personalidade flexível), persistido no banco (não some no Vercel).
model ProfileMemory {
  chatKey   String   @id
  learned   String? // texto "Sobre você: ..."
  updatedAt DateTime @updatedAt
}
